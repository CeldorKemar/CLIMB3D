{
  "name": "climbed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @climbed/api\" \"npm run dev -w @climbed/web\"",
    "dev:web": "npm run dev -w @climbed/web",
    "dev:api": "npm run dev -w @climbed/api",
    "build": "npm run typecheck && npm run build -w @climbed/web",
    "start": "npm run start -w @climbed/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup:local": "node scripts/local-setup.mjs",
    "db:migrate": "npm run db:migrate -w @climbed/api",
    "db:seed": "npm run db:seed -w @climbed/api"
  },
  "dependencies": { "tsx": "4.20.6" },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "concurrently": "9.2.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
